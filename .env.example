# HELIX RSS self-hosting configuration.
# Copy this file to .env and adjust values.
# The app reads it automatically via `npm start` (node --env-file-if-exists=.env).

# Internal bind address for both the web dashboard and Discord bot endpoints.
# Use 0.0.0.0 to expose on LAN; leave as 127.0.0.1 for local-only access.
INTERNAL_URL=127.0.0.1

# Custom domain to bind to cloud host-provided dynamic URLs (e.g. https://rss.yourdomain.com).
# Overrides dynamic provider domains (Render, Railway, Fly) so Discord OAuth and bot links stay stable.
CUSTOM_URL=

# Public domain for external access (optional fallback alias for CUSTOM_URL).
# Set PUBLIC_URL or CUSTOM_URL if you are hosting behind a custom domain or reverse proxy.
PUBLIC_URL=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Primary port for the Discord bot service and HTTP endpoints (default 3131).
# The web dashboard runs as a managed sub-process incremented from this port (e.g. 3132).
DISCORD_PORT=3131

# Port for the Redis coordinator used for cross-instance deduplication (default 3535).
# Redis runs on the same host as the service (INTERNAL_URL). Set REDIS_PORT to match your Redis instance.
REDIS_PORT=3535

# Feed poll interval in milliseconds.
POLL_INTERVAL_MS=60000

# Site status monitor interval in milliseconds.
STATUS_INTERVAL_MS=30000

# HTTP request timeout in milliseconds.
REQUEST_TIMEOUT_MS=15000

# Where the SQLite database and runtime data live.
SQLITE_DATA=./data

# Scratch directory used by the test suite for temporary SQLite files.
SQLITE_TEST_DATA=./data/.tmp

# Discord bot credentials (Required for bot functionality).
# The bot starts automatically when DISCORD_TOKEN is set.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord Bot Invite & Authorization URL.
# Replace `your_client_id` with your actual Discord application client ID from
# the Discord Developer Portal. Users open this link to add the bot to their server.
DISCORD_REDIRECT_URL=https://discord.com/oauth2/authorize?client_id=your_client_id&permissions=8&integration_type=0&scope=bot+applications.commands

# --- Built-in HTTPS Proxy & Auto Self-Signed TLS ---
# The HTTPS proxy port allows accessing the bot and dashboard over HTTPS even without
# a custom domain or external SSL certificate (auto-generates self-signed TLS cert if needed).
HTTPS_PORT=3443

# --- Optional: Native SSL / HTTPS Certificates ---
# Provide paths to your custom SSL certificate and key for native HTTPS.
# If left empty, the built-in HTTPS proxy automatically generates a self-signed TLS cert.
SITE_SSL_KEY=
SITE_SSL_CERT=

# --- Optional: Keep-Alive Network Ping ---
# PING_URL is automatically derived from the host (INTERNAL_URL) and port (DISCORD_PORT):
# http://${INTERNAL_URL}:${DISCORD_PORT}/health
# Leave empty to automatically use the host and port, or set explicitly to ping an external URL.
# Set to 'disabled' or 'none' to turn off.
PING_URL=
PING_INTERVAL_MS=600000

