# HELIX RSS self-hosting configuration.
# Copy this file to .env and adjust values.
# The app reads it automatically via `npm start` (node --env-file-if-exists=.env).

# Internal bind address and port for both the web dashboard and Discord bot endpoints.
# This is the only place a port is configured (e.g. 127.0.0.1:3131 or 0.0.0.0:3131). Defaults to 127.0.0.1:3131.
INTERNAL_URL=127.0.0.1:3131

# Public URL or hosts-file alias (e.g. https:your-domain.com or https://rss.yourdomain.com).
# No port needs to be specified here — the HTTPS proxy port automatically increments from INTERNAL_URL (e.g. 3132),
# without exposing the port in the raw public URL.
# When set, the bot and dashboard use HTTPS via the built-in HTTPS proxy.
PUBLIC_URL=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Feed poll interval in milliseconds.
POLL_INTERVAL_MS=60000

# Site status monitor interval in milliseconds.
STATUS_INTERVAL_MS=30000

# HTTP request timeout in milliseconds.
REQUEST_TIMEOUT_MS=15000

# Where the SQLite database and runtime data live.
SQLITE_DATA=./data

# Scratch directory used by the test suite for temporary SQLite files.
SQLITE_TEST_DATA=./data/.tmp

# Discord bot credentials (Required for bot functionality).
# The bot starts automatically when DISCORD_TOKEN is set.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord Bot Invite & Authorization URL.
# Replace `your_client_id` with your actual Discord application client ID from
# the Discord Developer Portal. Users open this link to add the bot to their server.
DISCORD_REDIRECT_URL=https://discord.com/oauth2/authorize?client_id=your_client_id&permissions=8&integration_type=0&scope=bot+applications.commands

# --- Optional: Native SSL / HTTPS Certificates ---
# Provide paths to your custom SSL certificate and key for native HTTPS.
# If left empty, the built-in HTTPS proxy automatically generates a self-signed TLS cert.
SITE_SSL_KEY=
SITE_SSL_CERT=

# --- Optional: Keep-Alive Network Ping ---
# PING_URL is automatically derived from INTERNAL_URL:
# http://${INTERNAL_URL}/health
# Leave empty to automatically ping the health endpoint, or set explicitly to ping an external URL.
# Set to 'disabled' or 'none' to turn off.
PING_URL=
PING_INTERVAL_MS=600000


