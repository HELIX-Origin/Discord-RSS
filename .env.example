# Discord RSS self-hosting configuration.
# Copy this file to .env and adjust values. The app reads it automatically
# via `npm start` (node --env-file-if-exists=.env). All vars are optional.

# Port the web dashboard + API listen on (default 3434)
DISCORD_RSS_PORT=3434

# Bind address (default 127.0.0.1). Use 0.0.0.0 to expose on your LAN.
DISCORD_RSS_HOST=127.0.0.1

# Where the SQLite database lives (default ./data)
#DISCORD_RSS_DATA=./data

# Polling intervals in milliseconds
#DISCORD_RSS_POLL_INTERVAL_MS=60000
#DISCORD_RSS_STATUS_INTERVAL_MS=30000
#DISCORD_RSS_REQUEST_TIMEOUT_MS=15000

# Public base URL used when the dashboard is behind a reverse proxy,
# e.g. https://rss.example.com. Also used to build OAuth redirect URIs.
# Of lower priority than the "public_base_url" value saved in the dashboard
# (Settings tab), which can override this at any time.
#DISCORD_RSS_PUBLIC_BASE_URL=https://rss.example.com

# --- OAuth provider credentials ---
# Provider client-id/secret/enabled are NOT env vars. They are stored in the
# SQLite settings table and configured from the dashboard under the
# "Integrations" tab (or via POST /api/settings/oauth/:provider).