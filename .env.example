# Site-Feed-Discord Environment Variables
# Copy this file to .env and configure your values.
# This file must never be committed to the repository.

# Base site URL
SITE_URL=https://example.com

# Feed URLs (named after their source; multiple supported)
FORUM_RSS_URL_001=https://example.com/feed.xml
SITE_RSS_URL_001=https://example.com/rss.xml

# Webhook URLs (named after service; Discohook is the primary/default method)
DISCOHOOK_WEBHOOK_URL_001=https://discord.com/api/webhooks/...
DISCOHOOK_WEBHOOK_URL_002=https://discord.com/api/webhooks/...
SITE_STATUS_WEBHOOK_URL_001=https://discord.com/api/webhooks/...

# Optional external Cloudflare challenge-solving API (only for protected domains like vBulletin forums)
CLOUDFLARE_API_KEY=optional_key_here
CHALLENGE_SOLVER_URL=https://optional-solver.api/v1/solve

# Optional overrides
ALLOWED_HOSTS=example.com
EXCLUDED_URL_SUBSTRINGS=/admin,/moderator,/staff,/mod/
MAX_POSTS=5
