{
  "name": "helix-rss",
  "version": "0.1.0",
  "description": "Self-hosted RSS/Atom-to-Discord service for Discord communities. Built entirely in TypeScript ESM with zero runtime dependencies (native http, node:sqlite, built-in web dashboard, Discord bot, and API). Posts directly to Discord webhooks.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node --env-file-if-exists=.env dist/index.js",
    "dev": "tsc --watch",
    "dev:run": "node --env-file-if-exists=.env --watch dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "check": "npm run typecheck && npm run format:check && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "redis": "^5.12.1"
  },
  "allowScripts": {
    "msw@2.15.0": true
  }
}
